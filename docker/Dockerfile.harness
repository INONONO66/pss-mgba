FROM node:22-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@11.2.2 --activate

WORKDIR /app

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY viewer/package.json viewer/
COPY multi/package.json multi/

RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile

FROM base AS viewer-build

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/viewer/node_modules ./viewer/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY viewer/ ./viewer/

RUN cd viewer && pnpm build

FROM base AS runner

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/viewer/node_modules ./viewer/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY viewer/package.json ./viewer/
COPY viewer/tsconfig.json viewer/tsconfig.node.json ./viewer/
COPY viewer/vite.config.ts ./viewer/
COPY viewer/index.html ./viewer/
COPY viewer/src/ ./viewer/src/
COPY --from=viewer-build /app/viewer/dist ./viewer/dist

RUN mkdir -p runs

ENV NODE_ENV=production
ENV DEV_VIEWER_PORT=8787
ENV DEV_VIEWER_HOST=0.0.0.0

EXPOSE 8787

CMD ["npx", "tsx", "src/cli/dev.ts"]
