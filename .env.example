MGBA_HTTP_BASE_URL=http://127.0.0.1:5001
POKEMON_VERSION=red
POKEMON_ROM_PATH=/absolute/path/to/legal/rom.gb
EVIDENCE_DIR=runs
HARNESS_RUN_ID=
HARNESS_MODE=full-game
LOG_LEVEL=info
LOOP_MAX_STEPS=999999
LOOP_STEP_DELAY_MS=250
DEFAULT_TAP_FRAMES=5
DEFAULT_HOLD_FRAMES=15
# AI_PROVIDER is always openai-compatible. No heuristic fallback is used.
AI_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:3100/v1
OPENAI_API_KEY=
OPENAI_MODEL=grok-4.3
OPENAI_TEMPERATURE=0.2
DEV_VIEWER_PORT=8787

# Optional upstream runtime utility aliases.
# The fork harness uses OPENAI_* and POKEMON_ROM_PATH; these AI_* and MGBA_ROM_PATH
# values are consumed only by the additive runtime/metrics utilities pulled from upstream.
MGBA_ROM_PATH=/absolute/path/to/legal/rom.gb
AI_BASE_URL=http://127.0.0.1:3100/v1
AI_API_KEY=
AI_MODEL=grok-4.3
AI_REASONING=medium
AI_TEMPERATURE=0.2
METRICS_HTTP_HOST=0.0.0.0
METRICS_HTTP_PORT=9464
