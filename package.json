{
  "name": "typescript-pokemon-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "check:secrets": "tsx scripts/check-no-secrets.ts",
    "lint": "biome check .",
    "check": "pnpm run check:secrets && pnpm run typecheck && pnpm test && pnpm run smoke:memory-map-build",
    "harness": "tsx src/cli/index.ts",
    "harness:full-game": "tsx src/cli/index.ts run --max-turns 1500",
    "dev": "tsx src/cli/dev.ts",
    "viewer:dev": "cd viewer && pnpm dev",
    "viewer:build": "cd viewer && pnpm build",
    "tools:test": "tsx scripts/test-agent-tools.ts",
    "tools:test:live-dialog": "tsx scripts/test-live-dialog.ts",
    "build": "tsc -p tsconfig.json && tsx scripts/copy-data-assets.ts",
    "smoke:memory-map-build": "pnpm run build && tsx scripts/verify-built-memory-map.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.0-canary.48",
    "@minpeter/pss-runtime": "^0.0.6",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "7.0.0-canary.142",
    "dotenv": "17.4.2",
    "openai": "latest",
    "sharp": "^0.34.5",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "25.9.1",
    "@types/ws": "^8.18.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "ultracite": "7.7.0",
    "vitest": "4.1.7"
  }
}
